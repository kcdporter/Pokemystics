# Security headers for the deployed static site.
# Applied by Netlify and Cloudflare Pages (copied to dist/ root at build).
# GitHub Pages does NOT support custom headers — prefer Cloudflare Pages /
# Netlify if you want these enforced.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()

# Long-cache the immutable, content-hashed build assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Sprites are stable; cache hard
/mons/*
  Cache-Control: public, max-age=604800
